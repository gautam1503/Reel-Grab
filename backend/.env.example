PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development

# Optional Proxy Settings (For firewalled networks)
# HTTP_PROXY=http://127.0.0.1:8080
# HTTPS_PROXY=http://127.0.0.1:8080

# Optional yt-dlp / ffmpeg settings
# YTDLP_PATH=C:\tools\yt-dlp.exe          # explicit yt-dlp binary (auto-detected otherwise)
# FFMPEG_PATH=C:\tools\ffmpeg\bin\ffmpeg.exe  # needed for full-HD (merged) downloads
# YTDLP_COOKIES_FILE=/app/cookies.txt     # Netscape cookies file if YouTube/Instagram demand sign-in
# MAX_CONCURRENT_DOWNLOADS=3
# MAX_DURATION_SECONDS=7200
